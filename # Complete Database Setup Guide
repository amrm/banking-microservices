\c accountdb;

-- View for account summary
CREATE OR REPLACE VIEW account_summary AS
SELECT 
    a.id,
    a.user_id,
    a.account_number,
    a.account_type,
    a.balance,
    a.currency,
    a.status,
    a.created_at,
    (SELECT COUNT(*) FROM accountdb.account_balance_history abh WHERE abh.account_id = a.id) as transaction_count
FROM accounts a;

\c transferdb;

-- View for transfer summary
CREATE OR REPLACE VIEW transfer_summary AS
SELECT 
    t.id,
    t.transfer_reference,
    t.user_id,
    t.from_account_id,
    t.to_account_id,
    t.amount,
    t.currency,
    t.status,
    t.workflow_required,
    t.initiated_at,
    t.completed_at,
    EXTRACT(EPOCH FROM (COALESCE(t.completed_at, CURRENT_TIMESTAMP) - t.initiated_at)) as duration_seconds
FROM transfers t;

