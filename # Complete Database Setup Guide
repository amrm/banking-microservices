-- TRANSFER DATABASE SCHEMA
-- ============================================
\c transferdb;

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- Transfers table
CREATE TABLE IF NOT EXISTS transfers (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    transfer_reference VARCHAR(50) UNIQUE NOT NULL,
    user_id UUID NOT NULL,
    from_account_id UUID NOT NULL,
    to_account_id UUID NOT NULL,
    amount DECIMAL(19,2) NOT NULL CHECK (amount > 0),
    currency VARCHAR(3) NOT NULL,
    status VARCHAR(30) NOT NULL CHECK (status IN ('INITIATED', 'PENDING_APPROVAL', 'APPROVED', 'REJECTED', 'COMPLETED', 'FAILED')),
    description VARCHAR(500),
    workflow_required BOOLEAN NOT NULL DEFAULT FALSE,
    workflow_id UUID,
    session_id VARCHAR(50),
    request_id VARCHAR(50),
    initiated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    completed_at TIMESTAMP
);

-- Create indexes for transfers
CREATE INDEX idx_transfers_user_id ON transfers(user_id);
CREATE INDEX idx_transfers_status ON transfers(status);
CREATE INDEX idx_transfers_initiated_at ON transfers(initiated_at);
CREATE INDEX idx_transfers_from_account ON transfers(from_account_id);
CREATE INDEX idx_transfers_to_account ON transfers(to_account_id);
CREATE INDEX idx_transfers_reference ON transfers(transfer_reference);
CREATE INDEX idx_transfers_session_id ON transfers(session_id);
CREATE INDEX idx_transfers_request_id ON transfers(request_id);

-- Transfer status history
CREATE TABLE IF NOT EXISTS transfer_status_history (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    transfer_id UUID NOT NULL REFERENCES transfers(id),
    old_status VARCHAR(30),
    new_status VARCHAR(30) NOT NULL,
    changed_by VARCHAR(50),
    changed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    comments TEXT
);

CREATE INDEX idx_status_history_transfer_id ON transfer_status_history(transfer_id);
CREATE INDEX idx_status_history_changed_at ON transfer_status_history(changed_at);

-- Trigger to log status changes
CREATE OR REPLACE FUNCTION log_transfer_status_change()
RETURNS TRIGGER AS $$
BEGIN
    IF (TG_OP = 'INSERT') THEN
        INSERT INTO transfer_status_history (transfer_id, old_status, new_status)
        VALUES (NEW.id, NULL, NEW.status);
    ELSIF (OLD.status != NEW.status) THEN
        INSERT INTO transfer_status_history (transfer_id, old_status, new_status)
        VALUES (NEW.id, OLD.status, NEW.status);
    END IF;
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER trigger_log_transfer_status
    AFTER INSERT OR UPDATE ON transfers
    FOR EACH ROW
    EXECUTE FUNCTION log_transfer_status_change();

